4:00 w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.9e4d9436c0e7b6043fa60b5d83484fce1dfd4ab4.001.1,2026-10-06T07:40:00-04:00"]},"scope":"Public","code":"IPAWSv1.0","language":"en-US","web":"http://www.weather.gov","eventCode":{"SAME":["FLS"],"NationalWeatherService":["FLW"]}}},{"id":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.ef098c6ac7a960ad0cb3dc5ebc41f9f644bc585d.001.1","type":"Feature","geometry":{"type":"Polygon","coordinates":[[[-111.92,33.44],[-111.9,33.44],[-111.89,33.57],[-111.96,33.6],[-112,33.58],[-111.93,33.55],[-111.92,33.44]]]},"properties":{"@id":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.ef098c6ac7a960ad0cb3dc5ebc41f9f644bc585d.001.1","@type":"wx:Alert","id":"urn:oid:2.49.0.1.840.0.ef098c6ac7a960ad0cb3dc5ebc41f9f644bc585d.001.1","areaDesc":"Maricopa, AZ","geocode":{"SAME":["004013"],"UGC":["AZC013"]},"affectedZones":["https://api.weather.gov/zones/county/AZC013"],"references":[{"@id":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.cb2e79ec3f66a31622cbf2d2a3bc16059bc9518c.001.1","identifier":"urn:oid:2.49.0.1.840.0.cb2e79ec3f66a31622cbf2d2a3bc16059bc9518c.001.1","sender":"w-nws.webmaster@noaa.gov","sent":"2026-10-30T22:13:00-07:00"}],"sent":"2026-10-31T01:06:00-07:00","effective":"2026-10-31T01:06:00-07:00","onset":"2026-10-31T01:06:00-07:00","expires":"2026-10-31T03:15:00-07:00","ends":"2026-10-31T03:15:00-07:00","status":"Actual","messageType":"Update","category":"Met","severity":"Severe","certainty":"Likely","urgency":"Expected","event":"Flood Warning","sender":"w-nws.webmaster@noaa.gov","senderName":"NWS Phoenix AZ","headline":"Flood Warning issued October 31 at 1:06AM MST until October 31 at 3:15AM MST by NWS Phoenix AZ","description":"* WHAT...Flooding caused by excessive rainfall continues.\n\n* WHERE...Maricopa County in south central Arizona...\n\n* WHEN...Until 315 AM MST.\n\n* IMPACTS...Flooding of Indian Bend Wash is imminent or occurring.\nLow-water crossings are inundated with water and may not be\npassable. It will take several hours for all the water from these\nstorms to work through local drainage systems in urban areas.\n\n* ADDITIONAL DETAILS...\n- At 106 AM MST, streamflow gauge reports along Indian Bend Wash\nindicated water levels were above alarm stage due to runoff from\nearlier heavy rain. Flooding is already occurring in the warned\narea. Between 1 and 3 inches of rain have fallen.\n- Flooding impacts will continue, but no additional rainfall is\nexpected.\n- Some locations that will experience flooding include...\nParadise Valley and Scottsdale along Indian Bend Wash.\n- http://www.weather.gov/safety/flood","instruction":"Turn around, don't drown when encountering flooded roads. Most flood\ndeaths occur in vehicles.\n\nBe especially cautious at night when it is harder to recognize the\ndangers of flooding.\n\nBe aware of your surroundings and do not drive on flooded roads.","response":"Avoid","note":null,"parameters":{"AWIPSidentifier":["FLWPSR"],"WMOidentifier":["WGUS45 KPSR 310806"],"NWSheadline":["FLOOD WARNING NOW IN EFFECT UNTIL 315 AM MST EARLY THIS MORNING"],"BLOCKCHANNEL":["EAS","NWEM","CMAS"],"EAS-ORG":["WXR"],"VTEC":["/O.EXT.KPSR.FA.W.0010.000000T0000Z-261031T1015Z/"],"eventEndingTime":["2026-10-31T03:15:00-07:00"]},"scope":"Public","code":"IPAWSv1.0","language":"en-US","web":"http://www.weather.gov","eventCode":{"SAME":["FLW"],"NationalWeatherService":["FAW"]}}}]}